scope GameModules

	struct GameModule
	
		static method initialize takes nothing returns nothing
			//Multiboard
            if (SYSTEM_MULTIBOARD) then
                call FBFMultiboard.create()
            endif
			
			//Item System
			if (SYSTEM_ITEMS) then
                call UnitInventory.initialize()
            endif
			if (SYSTEM_ITEMS) then
                call ItemShops.initialize()
            endif
			if (SYSTEM_ITEMS) then
                call Item.initialize()
            endif
			if (SYSTEM_ITEMS) then
                call Items.initialize()
            endif
						
			//Hero Pick Systems
			if (SYSTEM_HERO_PICK) then
                call HeroPickInit.initialize()
            endif
			if (SYSTEM_HERO_PICK) then
                call HeroPickSystem.initialize()
            endif
			if (SYSTEM_HERO_PICK) then
                call HeroPickMode.initialize()
            endif
			
			//Hero Repick
			if (SYSTEM_HERO_PICK) then
                call Repick.initialize()
            endif
			
			//Hero Stats
			if (SYSTEM_HERO_PICK) then
                call HeroData.initialize()
            endif
			if (SYSTEM_HERO_PICK) then
                call HeroStats.initialize()
            endif
			
			//Tome Damage System System
			if (SYSTEM_SUPPORT) then
                call TDS.initialize()
            endif
			
			//Kill Streak System
			if (SYSTEM_SUPPORT) then
                call KillStreakSystem.initialize()
            endif
			
			//Assist System
			if (SYSTEM_SUPPORT) then
                call AssistSystem.initialize()
            endif
			
			//XP System
			if (SYSTEM_SUPPORT) then
                call XPSystem.initialize()
            endif
			
			//Tower System
			if (SYSTEM_TOWERS) then
                call TowerSystem.initialize()
            endif
			
			//Unit System
			if (SYSTEM_UNITS) then
                call UnitSystem.initialize()
            endif
			
			//Gold System
			if (SYSTEM_GOLD_INCOME) then
                call BonusGoldOnStreak.initialize()
            endif
			
			//Debug-Goldbefehl
			if (SYSTEM_SUPPORT) then
                call DebugGoldChat.initialize()
            endif

			//Evaluation System
			if (SYSTEM_SUPPORT) then
                call Evaluation.initialize()
            endif
			
			//Web System
			if (SYSTEM_SUPPORT) then
                call WebSystem.initialize()
            endif
			
			//Graveyard Systems
			if (SYSTEM_SPIKE_TRAPS) then
                call SpikeTrap.initialize()
            endif
			if (SYSTEM_SKELETONS) then
                call SkeletonSystem.initialize()
            endif
			if (SYSTEM_GRAVESTONES) then
                call GravestoneSystem.initialize()
            endif
			
			//Usability System
			if (SYSTEM_HERO_PICK) then
                call Usability.initialize()
            endif
			
			//KI Systems
			if (SYSTEM_AI) then
                call KI.initialize()
            endif
			
			//create Brood Mother
            if (SYSTEM_BROOD) then
                call BroodMother.create()
            endif
			
            //create EggSystem
            if (SYSTEM_BROOD) then
                call EggSystem.create()
            endif
			
            //Create Titan Devourer
            if (SYSTEM_TITAN) then
                call Titan.create()
            endif
			
            //Create Coalition Unit Shops
            if (SYSTEM_UNITS) then
                call UnitShopSystem.initialize()
            endif
			
            //init Final Mode
            if (SYSTEM_FINAL_MODE) then
                call FinalMode.initialize()
            endif
			
            //create first Coalition Teleporter in the AOS
            if (SYSTEM_TELEPORT and Game.getCoalitionPlayers() > 0) then
                call CoalitionTeleport.initialize()
            endif

            //create first Forsaken Teleporter in the AOS
            if (SYSTEM_TELEPORT and Game.getForsakenPlayers() > 0) then
                call ForsakenTeleport.initialize()
            endif

			//init Defense Mode
			if (SYSTEM_DEFENSE) then
                call StandardDefenseInit.initialize()
            endif
			
			//Test: Send Unit System
			if (SYSTEM_ROUNDS) then
                call CustomCreepSystem.initialize()
            endif
			
			// Camera System (only zoom)v
			if (SYSTEM_HERO_PICK) then
                call CameraSystem.initialize()
            endif
		endmethod
	
	endstruct

endscope