library DamageEvent initializer Init requires DamageEngine, DamageTypes, optional DamageModifiers, optional SpellDamage

    public function interface Response takes unit damagedUnit, unit damageSource, real damage returns nothing

    globals
        private constant real DAMAGE_THRESHOLD = 0.0
        private Response array responses
        private integer responsesCount = 0
    endglobals

    function RegisterDamageResponse takes Response r returns nothing
        set responses[responsesCount] = r
        set responsesCount = responsesCount + 1
    endfunction

    function ResetIsDead takes nothing returns nothing
        set IsDead = false
    endfunction

    private function OnDamage takes nothing returns boolean
        local unit damaged = Damage.target
        local unit damager = Damage.source
        local real damage = Damage.amount
        local integer i = 0

        if Damage.index.userType == DAMAGE_TAG_DUMMY then
            set damaged = null
            set damager = null
            return false
        endif

        if damage > DAMAGE_THRESHOLD then
            set DamageType = GetDamageTypeFromTag(Damage.index.userType)
            if GetWidgetLife(damaged) - damage < UNIT_MIN_LIFE then
                set IsDead = true
            endif

            loop
                exitwhen i >= responsesCount
                call responses[i].execute(damaged, damager, damage)
                set i = i + 1
            endloop
            set DamageType = PHYSICAL
        endif

        set damaged = null
        set damager = null
        return false
    endfunction

    private function Init takes nothing returns nothing
        set udg_DamageEventAOEGroup = CreateGroup()
        call DamageEngine_DebugStr()
        call RegisterDamageEngine(function OnDamage, "Modifier", 5.0)
    endfunction
endlibrary
