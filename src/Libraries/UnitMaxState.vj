library UnitMaxState

// Der Anteil der aktuellen HP/Mana bleibt bei einer Aenderung des Maximums gleich.
// Dadurch bleiben neu erzeugte volle Einheiten voll und beschaedigte Einheiten beschaedigt.
function SetUnitMaxState takes unit target, unitstate state, real targetValue returns nothing
    local real oldMax
    local real current
    local real fraction

    if state == UNIT_STATE_MAX_LIFE then
        if targetValue < 1 then
            debug call BJDebugMsg("SetUnitMaxState: Max-HP muss mindestens 1 sein")
            return
        endif

        set oldMax = GetUnitState(target, UNIT_STATE_MAX_LIFE)
        if R2I(targetValue) == R2I(oldMax) then
            return
        endif
        set current = GetUnitState(target, UNIT_STATE_LIFE)
        set fraction = 0
        if oldMax > 0 then
            set fraction = current / oldMax
        endif
        call BlzSetUnitMaxHP(target, R2I(targetValue))
        call SetUnitState(target, UNIT_STATE_LIFE, GetUnitState(target, UNIT_STATE_MAX_LIFE) * fraction)
    elseif state == UNIT_STATE_MAX_MANA then
        if targetValue < 0 then
            debug call BJDebugMsg("SetUnitMaxState: Max-Mana darf nicht negativ sein")
            return
        endif

        set oldMax = GetUnitState(target, UNIT_STATE_MAX_MANA)
        if R2I(targetValue) == R2I(oldMax) then
            return
        endif
        set current = GetUnitState(target, UNIT_STATE_MANA)
        set fraction = 0
        if oldMax > 0 then
            set fraction = current / oldMax
        endif
        call BlzSetUnitMaxMana(target, R2I(targetValue))
        call SetUnitState(target, UNIT_STATE_MANA, GetUnitState(target, UNIT_STATE_MAX_MANA) * fraction)
    else
        call SetUnitState(target, state, targetValue)
    endif
endfunction

function AddUnitMaxState takes unit target, unitstate state, real additionalValue returns nothing
    call SetUnitMaxState(target, state, GetUnitState(target, state) + additionalValue)
endfunction

endlibrary