library DamageModifiers initializer Init requires Table, DamageEngine, DamageTypes

// Die Modifier laufen weiterhin nach absteigender Prioritaet.
// Der berechnete Schaden wird im aktuellen Damage-Ereignis gesetzt.

    globals
        private constant boolean NEW_MODIFIER_ON_TOP = true
    endglobals

    private interface DamageModiferTemplate
        method onDamageDealt takes unit damagedUnit, real damage returns real defaults 0.0
        method onDamageTaken takes unit damageSource, real damage returns real defaults 0.0
    endinterface

    struct DamageModifier extends DamageModiferTemplate
        private unit targetunit
        integer priority
        private DamageModifier next = 0
        private static HandleTable first

        private method listInsert takes nothing returns nothing
            local DamageModifier dm = DamageModifier(DamageModifier.first[.targetunit])
            if dm == 0 or dm.priority < .priority or (NEW_MODIFIER_ON_TOP and dm.priority == .priority) then
                set .next = DamageModifier(DamageModifier.first[.targetunit])
                set DamageModifier.first[.targetunit] = integer(this)
            else
                loop
                    exitwhen dm.next == 0 or dm.next.priority < .priority or (NEW_MODIFIER_ON_TOP and dm.next.priority == .priority)
                    set dm = dm.next
                endloop
                set .next = dm.next
                set dm.next = this
            endif
        endmethod

        private method listRemove takes nothing returns nothing
            local DamageModifier dm = DamageModifier(DamageModifier.first[.targetunit])
            if dm == this then
                set DamageModifier.first[.targetunit] = integer(.next)
            else
                loop
                    exitwhen dm.next == this
                    set dm = dm.next
                endloop
                set dm.next = .next
            endif
        endmethod

        static method create takes unit u, integer priority returns DamageModifier
            local DamageModifier this
            if u == null then
                return 0
            endif
            set this = DamageModifier.allocate()
            set .targetunit = u
            set .priority = priority
            call .listInsert()
            return this
        endmethod

        method onDestroy takes nothing returns nothing
            call .listRemove()
            if DamageModifier.first[.targetunit] == 0 then
                call DamageModifier.first.flush(.targetunit)
            endif
            set .targetunit = null
        endmethod

        static method onInit takes nothing returns nothing
            set DamageModifier.first = HandleTable.create()
        endmethod

        static method Evaluate takes unit damaged, unit damager, real damage returns real
            local real modifier = 0.0
            local DamageModifier outgoing = DamageModifier(DamageModifier.first[damager])
            local DamageModifier incoming = DamageModifier(DamageModifier.first[damaged])
            loop
                exitwhen outgoing == 0 and incoming == 0
                if outgoing != 0 and (incoming == 0 or outgoing.priority >= incoming.priority) then
                    set modifier = modifier + outgoing.onDamageDealt(damaged, damage + modifier)
                    set outgoing = outgoing.next
                elseif incoming != 0 then
                    set modifier = modifier + incoming.onDamageTaken(damager, damage + modifier)
                    set incoming = incoming.next
                endif
            endloop
            return modifier
        endmethod
    endstruct

    function RunDamageModifiers takes nothing returns real
        local unit damaged = Damage.target
        local unit damager = Damage.source
        local real damage = Damage.amount
        local integer previousType = DamageType

        if damaged == null or Damage.index.userType == DAMAGE_TAG_DUMMY then
            set damager = null
            return 0.0
        endif

        set DamageType = GetDamageTypeFromTag(Damage.index.userType)
        set damage = damage + DamageModifier.Evaluate(damaged, damager, damage)
        set Damage.amount = damage
        set DamageType = previousType

        set damaged = null
        set damager = null
        return damage
    endfunction

    private function OnDamage takes nothing returns boolean
        call RunDamageModifiers()
        return false
    endfunction

    private function Init takes nothing returns nothing
        call RegisterDamageEngine(function OnDamage, "Modifier", 4.0)
    endfunction

    function GetUnitLife takes unit u returns real
        return GetWidgetLife(u)
    endfunction

    function SetUnitLife takes unit u, real newLife returns nothing
        call SetWidgetLife(u, newLife)
    endfunction
endlibrary
